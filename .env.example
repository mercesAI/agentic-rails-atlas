# Optional, read-only data fetchers. Nothing here is required for the build.
# GITHUB_TOKEN=            # raises the GitHub API rate limit for scripts/data/github.ts
# CLOUDFLARE_RADAR_TOKEN=  # optional Cloudflare Radar AI Insights (CC BY-NC 4.0)
# ETH_RPC_URL=             # optional public read-only RPC for the ERC-8004 live lookup (stretch)
GRAPH_API_KEY=
PUBLIC_SITE_URL=https://atlas.merces.ai

# pnpm stats. Put these in .env, which git ignores. The token is read-only: Account Analytics
# Read plus zone Analytics Read.
# ATLAS_STATS_CF_TOKEN=
# ATLAS_STATS_CF_ACCOUNT_ID=
# ATLAS_STATS_CF_ZONE_ID=
# ATLAS_STATS_SITE_TAG=     # optional Web Analytics site tag; without it the host filter is used
# ATLAS_STATS_HOST=         # optional, default atlas.merces.ai
