---
/**
 * Mermaid diagram rendered at build time (ARCHITECTURE.md Section 6).
 * The drawing is the theme-neutral src/generated/diagrams/<id>.svg, whose
 * theme colors are CSS variables defined for both themes in colors.css. A lazy
 * figure (the default) does not carry it: the build emits the file under
 * /_astro/ with a content hash and the figure script fetches it when the
 * figure nears the viewport, or earlier in idle time, and inlines it so the
 * page's color variables apply. Until then a placeholder reserves the drawn
 * size. A figure with lazy={false} inlines its drawing. A diagram the renderer
 * could not fold keeps <id>.light.svg and <id>.dark.svg, both inlined (in a
 * template when lazy), and CSS shows the one matching the theme. Caption, a
 * "text alternative" disclosure and a "source of truth" link. When the SVG is
 * missing, shows the .mmd source in a <pre> with a "not rendered" note; never
 * fails the build. Named an island for the contract; it is not hydrated.
 */
import { diagramMetaById } from '../protocol/lib/load';
import { suffixIds as suffixSvgIds } from '../../lib/diagrams/suffix-ids';
import { naturalSize, naturalSvg } from '../../lib/diagrams/natural';

export interface Props {
  id: string;
  title?: string;
  caption?: string;
  /** Text alternative paragraph. */
  alt?: string;
  /** Text alternative as an ordered list (flow steps, transitions). */
  altSteps?: string[];
  /** Per-state notes of a state machine, shown as a list under the figure (they are no longer drawn inside it). */
  notes?: { label: string; note: string }[];
  sourceOfTruth?: { url: string; label: string };
  /** Repository path of the data the diagram is generated from. */
  generatedFrom?: string;
  /** Heading level for the title. */
  level?: 3 | 4;
  /**
   * Load the drawing when the figure nears the viewport (default true): it is
   * fetched as a file and inlined then, which keeps the page small and the
   * live DOM free of thousands of SVG nodes. Printing uses the drawings loaded
   * by then (they are fetched in idle time); without JavaScript the figure
   * shows its text alternative.
   */
  lazy?: boolean;
  /**
   * Fetch the drawing as soon as the page loads instead of when the figure nears the viewport,
   * for the figure readers meet first (the main flow). Still a file, never inlined.
   */
  eager?: boolean;
}

const SVGS = import.meta.glob<string>('/src/generated/diagrams/*.svg', { query: '?raw', import: 'default' });
/**
 * The same files as hashed build assets (/_astro/<id>.<hash>.svg), for the figures that load their drawing.
 * no-inline: Vite would turn a file under 4 KB into a data: URL, which the site's connect-src 'self' blocks.
 */
const SVG_URLS = import.meta.glob<string>('/src/generated/diagrams/*.svg', { query: '?url&no-inline', import: 'default' });
const MMD = {
  ...import.meta.glob<string>('/src/generated/mermaid/*.mmd', { query: '?raw', import: 'default' }),
  ...import.meta.glob<string>('/src/content/diagrams/*.mmd', { query: '?raw', import: 'default' }),
};

const p = Astro.props;
const meta = p.caption && p.alt ? null : await diagramMetaById(p.id).catch(() => null);
const title = p.title ?? meta?.title ?? p.id;
const caption = p.caption ?? meta?.caption;
const alt = p.alt ?? meta?.alt;
const sot = p.sourceOfTruth ?? meta?.sourceOfTruth;
const Level = p.level === 4 ? 'h4' : 'h3';
const lazy = p.lazy ?? true;

const load = async (key: string, table: Record<string, () => Promise<string>>) => {
  const fn = table[key];
  return fn ? await fn().catch(() => null) : null;
};
/**
 * Natural size (naturalSvg) and ids suffixed with the diagram id: pages inline many diagrams and Mermaid
 * reuses ids such as actor3 in each. The figure script applies the same two steps to a loaded file.
 */
const prepare = (svg: string | null, suffix: string): string | null => (svg ? suffixSvgIds(naturalSvg(svg), suffix) : null);
const neutralRaw = await load(`/src/generated/diagrams/${p.id}.svg`, SVGS);
/** URL of the drawing when the figure loads it as a file: lazy figures with a theme-neutral drawing. */
const src = lazy && neutralRaw ? await load(`/src/generated/diagrams/${p.id}.svg`, SVG_URLS) : null;
const neutral = src ? null : prepare(neutralRaw, `-${p.id}`);
const light = neutralRaw ? null : prepare(await load(`/src/generated/diagrams/${p.id}.light.svg`, SVGS), `-${p.id}`);
const dark = neutralRaw ? null : prepare(await load(`/src/generated/diagrams/${p.id}.dark.svg`, SVGS), `-${p.id}-dark`);
const single = neutral ?? light ?? dark;
const rendered = Boolean(src || single);
/** The drawn size a lazy placeholder reserves, so revealing the drawing never moves the page. */
const size = naturalSize(src && neutralRaw ? naturalSvg(neutralRaw) : single ?? '');
const placeholderStyle = size ? `--dw:${size.w};--dh:${size.h}` : undefined;
const mmd = rendered
  ? null
  : (await load(`/src/generated/mermaid/${p.id}.mmd`, MMD)) ?? (await load(`/src/content/diagrams/${p.id}.mmd`, MMD));
const domId = `diagram-${p.id}`;
---
<figure class="diagram-figure" id={domId} data-diagram={p.id} data-rendered={rendered ? 'true' : 'false'}>
  <Level class="diagram-figure__title" id={`${domId}-title`}>{title}</Level>
  {rendered ? (
    <div class="diagram-figure__tools">
      <p class="diagram-figure__hint" data-scroll-hint hidden>Scroll to see the whole diagram</p>
      <button type="button" class="btn btn--ghost diagram-figure__size" data-diagram-size aria-pressed="false" hidden>Actual size<span class="sr-only">: {title}</span></button>
      <button type="button" class="btn btn--ghost diagram-figure__fs" data-diagram-fullscreen aria-haspopup="dialog">View full screen<span class="sr-only">: {title}</span></button>
    </div>
    <div
      class="diagram-figure__canvas"
      role="region"
      tabindex="0"
      aria-label={`${title} (diagram preview; use View full screen to read it)`}
      aria-describedby={caption ? `${domId}-cap` : undefined}
      data-lazy-diagram={lazy ? '' : undefined}
      data-diagram-src={src ?? undefined}
      data-eager={src && p.eager ? '' : undefined}
    >
      {src ? (
        <>
          <div class="diagram-figure__placeholder" style={placeholderStyle}>
            <p class="diagram-figure__loading" role="status">{p.eager ? 'Diagram is loading.' : 'Diagram loads when it scrolls into view.'}</p>
          </div>
          <noscript><p class="diagram-figure__note">Turn on JavaScript to see this diagram, or read the text alternative below.</p></noscript>
        </>
      ) : lazy ? (
        <>
          <template>
            {light && dark ? (
              <>
                <div class="diagram" data-theme-variant="light" set:html={light} />
                <div class="diagram" data-theme-variant="dark" set:html={dark} />
              </>
            ) : (
              <div class="diagram" set:html={single} />
            )}
          </template>
          <div class="diagram-figure__placeholder" style={placeholderStyle}>
            <p class="diagram-figure__loading" role="status">Diagram loads when it scrolls into view.</p>
          </div>
          <noscript><p class="diagram-figure__note">Turn on JavaScript to see this diagram, or read the text alternative below.</p></noscript>
        </>
      ) : light && dark ? (
        <>
          <div class="diagram" data-theme-variant="light" set:html={light} />
          <div class="diagram" data-theme-variant="dark" set:html={dark} />
        </>
      ) : (
        <div class="diagram" set:html={single} />
      )}
    </div>
  ) : (
    <div class="diagram-figure__missing">
      <p class="diagram-figure__note">Not rendered yet. Run <code>pnpm diagrams</code>. The Mermaid source follows.</p>
      {mmd ? <pre tabindex="0"><code>{mmd}</code></pre> : <p class="diagram-figure__note">No Mermaid source found for <code>{p.id}</code>.</p>}
    </div>
  )}
  <figcaption>
    {caption && <p id={`${domId}-cap`} class="diagram-figure__caption">{caption}</p>}
    <details class="diagram-figure__alt">
      <summary>Text alternative</summary>
      {alt && <p>{alt}</p>}
      {p.altSteps && p.altSteps.length > 0 && <ol>{p.altSteps.map((s) => <li>{s}</li>)}</ol>}
      {!alt && !(p.altSteps && p.altSteps.length) && <p>Text alternative in progress.</p>}
    </details>
    {p.notes && p.notes.length > 0 && (
      <details class="diagram-figure__notes">
        <summary>State notes ({p.notes.length})</summary>
        <dl>
          {p.notes.map((n) => (
            <>
              <dt>{n.label}</dt>
              <dd>{n.note}</dd>
            </>
          ))}
        </dl>
      </details>
    )}
    <p class="diagram-figure__sot">
      Source of truth:{' '}
      {sot ? <a href={sot.url} rel="noopener noreferrer external">{sot.label}<span class="sr-only"> (external link)</span></a> : 'not recorded'}
      {p.generatedFrom && <> Generated from <code>{p.generatedFrom}</code>.</>}
    </p>
  </figcaption>
</figure>

<script>
  import { naturalSvg } from '../../lib/diagrams/natural';
  import { suffixIds } from '../../lib/diagrams/suffix-ids';
  import { getItem, setItem } from '../../lib/storage';
  // Lazy diagrams: near the viewport the figure fetches its drawing (data-diagram-src) and inlines it, or swaps in
  // its <template> (two-file diagrams). Drawings are also fetched in idle time so printing and full screen have
  // them. A diagram wider than its column is shown fitted to the column as a preview (full screen is the reading
  // view); "Actual size" switches every canvas on the page to natural size with sideways scrolling.
  const SIZE_KEY = 'diagram-size';
  const prefersActual = () => getItem(SIZE_KEY) === 'actual';
  const updateFit = (canvas: Element) => {
    const figure = canvas.closest('.diagram-figure');
    const svg = canvas.querySelector<SVGSVGElement>('svg');
    const natural = Number(svg?.dataset.naturalWidth);
    const overflows = natural > 0 && natural > canvas.clientWidth + 1;
    const fit = overflows && !prefersActual();
    canvas.toggleAttribute('data-fit', fit);
    const toggle = figure?.querySelector<HTMLButtonElement>('[data-diagram-size]');
    if (toggle) {
      toggle.hidden = !overflows;
      toggle.setAttribute('aria-pressed', String(overflows && !fit));
    }
    const hint = figure?.querySelector<HTMLElement>('[data-scroll-hint]');
    if (hint) hint.hidden = fit || !(canvas.scrollWidth > canvas.clientWidth + 1);
  };
  const ro = typeof ResizeObserver === 'undefined' ? undefined : new ResizeObserver((entries) => entries.forEach((e) => updateFit(e.target)));
  const watch = (canvas: Element) => {
    updateFit(canvas);
    ro?.observe(canvas);
  };
  /** Drawings by URL once fetched (kept across page swaps), and the fetches in flight. */
  const loaded = new Map<string, string>();
  const loading = new Map<string, Promise<string | null>>();
  const fetchSvg = (url: string): Promise<string | null> => {
    let pending = loading.get(url);
    if (!pending) {
      pending = fetch(url)
        .then((res) => (res.ok ? res.text() : null))
        .catch(() => null)
        .then((text) => {
          // A failed fetch is forgotten, so the next attempt (back online) asks again.
          if (text) loaded.set(url, text);
          else loading.delete(url);
          return text;
        });
      loading.set(url, pending);
    }
    return pending;
  };
  /** Canvases whose drawing failed to load; retried when the browser comes back online. */
  const failed = new Set<Element>();
  const settle = (el: Element, content: Node) => {
    el.replaceChildren(content);
    el.removeAttribute('data-lazy-diagram');
    failed.delete(el);
    watch(el);
  };
  const place = (el: Element, text: string) => {
    const id = el.closest('.diagram-figure')?.getAttribute('data-diagram') ?? '';
    const div = document.createElement('div');
    div.className = 'diagram';
    // Same steps as the build applies to an inlined drawing: natural size, then ids suffixed with the diagram id.
    div.innerHTML = suffixIds(naturalSvg(text), `-${id}`);
    settle(el, div);
  };
  /**
   * Shows the drawing of a lazy canvas; resolves once it is in place or has failed to load. A drawing
   * already fetched is placed synchronously (no await is reached), which printing relies on.
   */
  const reveal = async (el: Element): Promise<void> => {
    if (!el.hasAttribute('data-lazy-diagram')) return;
    const tpl = el.querySelector(':scope > template');
    if (tpl instanceof HTMLTemplateElement) return settle(el, tpl.content.cloneNode(true));
    const src = el.getAttribute('data-diagram-src');
    if (!src) return;
    const text = loaded.get(src) ?? (await fetchSvg(src));
    if (!el.isConnected || !el.hasAttribute('data-lazy-diagram')) return;
    if (text) return place(el, text);
    failed.add(el);
    const note = el.querySelector('.diagram-figure__loading');
    if (note) note.textContent = 'This diagram could not load. The text alternative below describes it.';
  };
  const revealAll = () => document.querySelectorAll('[data-lazy-diagram]').forEach((el) => void reveal(el));
  window.addEventListener('online', () => [...failed].forEach((el) => (el.isConnected ? void reveal(el) : failed.delete(el))));
  const idle = (fn: () => void): void => {
    if (typeof window.requestIdleCallback === 'function') window.requestIdleCallback(fn, { timeout: 3000 });
    else setTimeout(fn, 300);
  };
  /**
   * Fetches every drawing of the page in idle time, two at a time, so printing (which cannot wait for a fetch)
   * and full screen find them ready. The service worker precaches the same files, so this costs little.
   */
  const prefetch = () => {
    const urls = [...new Set([...document.querySelectorAll('[data-diagram-src]')].map((el) => el.getAttribute('data-diagram-src') ?? ''))].filter(Boolean);
    const next = () => {
      const url = urls.shift();
      if (url) void fetchSvg(url).then(() => idle(next));
    };
    idle(next);
    idle(next);
  };
  let io: IntersectionObserver | undefined;
  /** Lazy placeholders reserve the natural width instead of the fitted one when the reader prefers actual size. */
  const markLazySize = () => document.querySelectorAll('[data-lazy-diagram]').forEach((c) => c.toggleAttribute('data-actual-size', prefersActual()));
  document.addEventListener('astro:page-load', () => {
    io?.disconnect();
    ro?.disconnect(); // observed canvases from the previous page would otherwise be retained
    markLazySize();
    document.querySelectorAll('.diagram-figure__canvas:not([data-lazy-diagram])').forEach(watch);
    const items = document.querySelectorAll('[data-lazy-diagram]');
    if (!items.length) return;
    if (!('IntersectionObserver' in window)) return revealAll();
    io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            void reveal(e.target);
            io?.unobserve(e.target);
          }
        }
      },
      { rootMargin: '800px 0px' },
    );
    items.forEach((el) => io?.observe(el));
    document.querySelectorAll('[data-lazy-diagram][data-eager]').forEach((el) => void reveal(el));
    prefetch();
  });
  // Printing cannot wait for a fetch: every drawing fetched by now is placed, and a figure whose drawing is still
  // missing prints its text alternative, opened for the print (browsers do not print a closed disclosure).
  const openedForPrint: HTMLDetailsElement[] = [];
  window.addEventListener('beforeprint', () => {
    revealAll();
    document.querySelectorAll('.diagram-figure__canvas[data-lazy-diagram]').forEach((canvas) => {
      const alt = canvas.closest('.diagram-figure')?.querySelector<HTMLDetailsElement>('details.diagram-figure__alt');
      if (alt && !alt.open) {
        alt.open = true;
        openedForPrint.push(alt);
      }
    });
  });
  window.addEventListener('afterprint', () => openedForPrint.splice(0).forEach((d) => (d.open = false)));

  /** The latest full-screen request; a request still waiting for its drawing opens only if it is the latest. */
  let openTicket = 0;
  const ZOOM_MIN = 0.25;
  const ZOOM_MAX = 3;
  const ZOOM_STEP = 1.25;
  let dialog: HTMLDialogElement | null = null;


  const ensureDialog = (): HTMLDialogElement => {
    if (dialog?.isConnected) return dialog;
    const d = document.createElement('dialog');
    d.className = 'diagram-dialog';
    d.setAttribute('aria-labelledby', 'diagram-dialog-title');
    d.innerHTML = `
      <div class="diagram-dialog__bar">
        <h2 id="diagram-dialog-title" class="diagram-dialog__title"></h2>
        <div class="diagram-dialog__tools" role="group" aria-label="Zoom">
          <button type="button" class="btn" data-zoom="fit" aria-label="Fit the whole diagram in the window">Fit</button>
          <button type="button" class="btn" data-zoom="out" aria-label="Zoom out">Zoom out</button>
          <button type="button" class="btn" data-zoom="reset" aria-label="Reset zoom">Reset</button>
          <button type="button" class="btn" data-zoom="in" aria-label="Zoom in">Zoom in</button>
          <output class="diagram-dialog__level" aria-live="polite"></output>
          <button type="button" class="btn" data-zoom="close">Close</button>
        </div>
      </div>
      <div class="diagram-dialog__body" role="region" tabindex="0" aria-label="Diagram, scroll to pan"></div>`;
    document.body.append(d);
    d.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === d) return d.close();
      const act = t.closest<HTMLElement>('[data-zoom]')?.dataset.zoom;
      if (act) zoom(d, act);
    });
    d.addEventListener('close', () => {
      d.querySelector('.diagram-dialog__body')?.replaceChildren();
    });
    dialog = d;
    return d;
  };

  const applyZoom = (d: HTMLDialogElement, scale: number) => {
    d.dataset.scale = String(scale);
    d.querySelectorAll<SVGSVGElement>('.diagram-dialog__body svg').forEach((svg) => {
      const w = Number(svg.dataset.naturalWidth);
      const vb = svg.viewBox.baseVal;
      if (!w || !vb.width) return;
      svg.setAttribute('width', String(Math.round(w * scale)));
      svg.setAttribute('height', String(Math.round(((vb.height / vb.width) * w) * scale)));
    });
    const out = d.querySelector('.diagram-dialog__level');
    if (out) out.textContent = `${Math.round(scale * 100)}%`;
  };

  /** Largest scale (at most 100%) at which the whole diagram fits inside the dialog body. */
  const fitScale = (d: HTMLDialogElement): number => {
    const body = d.querySelector<HTMLElement>('.diagram-dialog__body');
    const svg = body?.querySelector<SVGSVGElement>('svg');
    const w = Number(svg?.dataset.naturalWidth);
    const vb = svg?.viewBox.baseVal;
    if (!body || !svg || !w || !vb?.width) return 1;
    const h = (vb.height / vb.width) * w;
    const pad = 40;
    return Math.min(1, (body.clientWidth - pad) / w, (body.clientHeight - pad) / h);
  };

  const zoom = (d: HTMLDialogElement, act: string) => {
    if (act === 'close') return d.close();
    const cur = Number(d.dataset.scale || '1');
    const next = act === 'in' ? cur * ZOOM_STEP : act === 'out' ? cur / ZOOM_STEP : act === 'fit' ? fitScale(d) : 1;
    applyZoom(d, Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, next)));
  };

  document.addEventListener('click', async (e) => {
    const target = e.target as Element | null;
    const sizeBtn = target?.closest<HTMLElement>('[data-diagram-size]');
    if (sizeBtn) {
      setItem(SIZE_KEY, prefersActual() ? 'fit' : 'actual');
      document.querySelectorAll('.diagram-figure__canvas:not([data-lazy-diagram])').forEach(updateFit);
      markLazySize();
      return;
    }
    const btn = target?.closest<HTMLElement>('[data-diagram-fullscreen]');
    // A fitted preview opens full screen when selected; links inside the figure keep working.
    const preview = btn ? null : target?.closest<HTMLElement>('.diagram-figure__canvas[data-fit]');
    if (preview && target?.closest('a, button')) return;
    const figure = (btn ?? preview)?.closest('.diagram-figure');
    const canvas = figure?.querySelector('.diagram-figure__canvas');
    if (!figure || !canvas) return;
    // The drawing may still be loading. Meanwhile the trigger is busy, and a newer click or any key press cancels
    // the request, so a slow drawing never takes over a dialog opened since or pops up after the reader moved on.
    // A figure whose drawing failed keeps its note (a status region) and opens nothing.
    const ticket = ++openTicket;
    const trigger = btn ?? preview;
    const waiting = canvas.hasAttribute('data-lazy-diagram');
    const cancel = () => {
      if (openTicket === ticket) openTicket += 1;
    };
    if (waiting) {
      trigger?.setAttribute('aria-busy', 'true');
      document.addEventListener('pointerdown', cancel, { capture: true, once: true });
      document.addEventListener('keydown', cancel, { capture: true, once: true });
    }
    await reveal(canvas);
    if (waiting) {
      trigger?.removeAttribute('aria-busy');
      document.removeEventListener('pointerdown', cancel, { capture: true });
      document.removeEventListener('keydown', cancel, { capture: true });
    }
    if (ticket !== openTicket || dialog?.open || !canvas.querySelector('.diagram')) return;
    const d = ensureDialog();
    const title = figure.querySelector('.diagram-figure__title')?.textContent ?? 'Diagram';
    const titleEl = d.querySelector('.diagram-dialog__title');
    if (titleEl) titleEl.textContent = title;
    const body = d.querySelector('.diagram-dialog__body');
    // Clone through markup and run the same id rewrite the build uses, so the
    // copy keeps its scoped theme CSS, markers and clip paths while its ids stay unique.
    if (body) body.innerHTML = [...canvas.querySelectorAll('.diagram')].map((n) => suffixIds(n.outerHTML, '-fs')).join('');
    applyZoom(d, 1);
    d.showModal();
    (d.querySelector('.diagram-dialog__body') as HTMLElement | null)?.focus();
  });
  document.addEventListener('astro:before-swap', () => {
    dialog?.close();
    dialog?.remove();
    dialog = null;
  });
</script>
