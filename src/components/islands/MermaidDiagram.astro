---
/**
 * Mermaid diagram rendered at build time (ARCHITECTURE.md Section 6).
 * Inlines both theme variants from src/generated/diagrams/<id>.{light,dark}.svg;
 * CSS shows the one matching the theme. Caption, a "text alternative"
 * disclosure and a "source of truth" link. When the SVG is missing, shows the
 * .mmd source in a <pre> with a "not rendered" note; never fails the build.
 * Named an island for the contract; it ships no JavaScript.
 */
import { diagramMetaById } from '../protocol/lib/load';
import { suffixIds as suffixSvgIds } from '../../lib/diagrams/suffix-ids';

export interface Props {
  id: string;
  title?: string;
  caption?: string;
  /** Text alternative paragraph. */
  alt?: string;
  /** Text alternative as an ordered list (flow steps, transitions). */
  altSteps?: string[];
  sourceOfTruth?: { url: string; label: string };
  /** Repository path of the data the diagram is generated from. */
  generatedFrom?: string;
  /** Heading level for the title. */
  level?: 3 | 4;
  /**
   * Keep the SVG in an inert <template> until the figure nears the viewport
   * (default true). Mermaid SVGs hold thousands of nodes; this keeps the live
   * DOM small. Printing and no-JS fall back to the inline SVG.
   */
  lazy?: boolean;
}

const SVGS = import.meta.glob<string>('/src/generated/diagrams/*.svg', { query: '?raw', import: 'default' });
const MMD = {
  ...import.meta.glob<string>('/src/generated/mermaid/*.mmd', { query: '?raw', import: 'default' }),
  ...import.meta.glob<string>('/src/content/diagrams/*.mmd', { query: '?raw', import: 'default' }),
};

const p = Astro.props;
const meta = p.caption && p.alt ? null : await diagramMetaById(p.id).catch(() => null);
const title = p.title ?? meta?.title ?? p.id;
const caption = p.caption ?? meta?.caption;
const alt = p.alt ?? meta?.alt;
const sot = p.sourceOfTruth ?? meta?.sourceOfTruth;
const Level = p.level === 4 ? 'h4' : 'h3';
const lazy = p.lazy ?? true;

const load = async (key: string, table: Record<string, () => Promise<string>>) => {
  const fn = table[key];
  return fn ? await fn().catch(() => null) : null;
};
/**
 * Pins the SVG to its natural size (from the viewBox) so text keeps the size it
 * was drawn at; the canvas scrolls sideways instead of shrinking the diagram.
 */
const natural = (svg: string | null): string | null => {
  if (!svg) return svg;
  return svg.replace(/<svg\b[^>]*>/, (tag) => {
    const vb = /viewBox="\s*[-\d.]+[ ,]+[-\d.]+[ ,]+([\d.]+)[ ,]+([\d.]+)\s*"/.exec(tag);
    if (!vb) return tag;
    const w = Math.round(Number(vb[1]));
    const h = Math.round(Number(vb[2]));
    return tag
      .replace(/\swidth="[^"]*"/, '')
      .replace(/\sheight="[^"]*"/, '')
      .replace(/\sstyle="[^"]*"/, '')
      .replace(/^<svg\b/, `<svg width="${w}" height="${h}" data-natural-width="${w}"`);
  });
};
/** Suffixes every id in an inlined SVG so diagrams never collide on one page (shared with the full-screen copy). */
const suffixIds = (svg: string | null, suffix: string): string | null => (svg ? suffixSvgIds(svg, suffix) : svg);
// Pages inline many diagrams and Mermaid reuses ids such as actor3 in each, so every id gets the diagram id as a suffix.
const light = suffixIds(natural(await load(`/src/generated/diagrams/${p.id}.light.svg`, SVGS)), `-${p.id}`);
const dark = suffixIds(natural(await load(`/src/generated/diagrams/${p.id}.dark.svg`, SVGS)), `-${p.id}-dark`);
const rendered = Boolean(light || dark);
const mmd = rendered
  ? null
  : (await load(`/src/generated/mermaid/${p.id}.mmd`, MMD)) ?? (await load(`/src/content/diagrams/${p.id}.mmd`, MMD));
const domId = `diagram-${p.id}`;
---
<figure class="diagram-figure" id={domId} data-diagram={p.id} data-rendered={rendered ? 'true' : 'false'}>
  <Level class="diagram-figure__title" id={`${domId}-title`}>{title}</Level>
  {rendered ? (
    <div class="diagram-figure__tools">
      <p class="diagram-figure__hint" data-scroll-hint hidden>Scroll to see the whole diagram</p>
      <button type="button" class="btn btn--ghost diagram-figure__fs" data-diagram-fullscreen aria-haspopup="dialog">View full screen<span class="sr-only">: {title}</span></button>
    </div>
    <div
      class="diagram-figure__canvas"
      role="region"
      tabindex="0"
      aria-label={`${title} (scrollable diagram)`}
      aria-describedby={caption ? `${domId}-cap` : undefined}
      data-lazy-diagram={lazy ? '' : undefined}
    >
      {lazy ? (
        <>
          <template>
            {light && dark ? (
              <>
                <div class="diagram" data-theme-variant="light" set:html={light} />
                <div class="diagram" data-theme-variant="dark" set:html={dark} />
              </>
            ) : (
              <div class="diagram" set:html={light ?? dark} />
            )}
          </template>
          <p class="diagram-figure__loading">Diagram loads when it scrolls into view.</p>
          <noscript><p class="diagram-figure__note">Turn on JavaScript to see this diagram, or read the text alternative below.</p></noscript>
        </>
      ) : light && dark ? (
        <>
          <div class="diagram" data-theme-variant="light" set:html={light} />
          <div class="diagram" data-theme-variant="dark" set:html={dark} />
        </>
      ) : (
        <div class="diagram" set:html={light ?? dark} />
      )}
    </div>
  ) : (
    <div class="diagram-figure__missing">
      <p class="diagram-figure__note">Not rendered yet. Run <code>pnpm diagrams</code>. The Mermaid source follows.</p>
      {mmd ? <pre tabindex="0"><code>{mmd}</code></pre> : <p class="diagram-figure__note">No Mermaid source found for <code>{p.id}</code>.</p>}
    </div>
  )}
  <figcaption>
    {caption && <p id={`${domId}-cap`} class="diagram-figure__caption">{caption}</p>}
    <details class="diagram-figure__alt">
      <summary>Text alternative</summary>
      {alt && <p>{alt}</p>}
      {p.altSteps && p.altSteps.length > 0 && <ol>{p.altSteps.map((s) => <li>{s}</li>)}</ol>}
      {!alt && !(p.altSteps && p.altSteps.length) && <p>Text alternative in progress.</p>}
    </details>
    <p class="diagram-figure__sot">
      Source of truth:{' '}
      {sot ? <a href={sot.url} rel="noopener noreferrer external">{sot.label}<span class="sr-only"> (external link)</span></a> : 'not recorded'}
      {p.generatedFrom && <> Generated from <code>{p.generatedFrom}</code>.</>}
    </p>
  </figcaption>
</figure>

<script>
  import { suffixIds } from '../../lib/diagrams/suffix-ids';
  // Swaps each lazy diagram's <template> into the live DOM near the viewport, and all of them before printing.
  // Also shows the "scroll" hint when a diagram overflows, and runs the full-screen dialog.
  const updateHint = (canvas: Element) => {
    const hint = canvas.parentElement?.querySelector<HTMLElement>('[data-scroll-hint]');
    if (!hint) return;
    hint.hidden = !(canvas.scrollWidth > canvas.clientWidth + 1);
  };
  const ro = typeof ResizeObserver === 'undefined' ? undefined : new ResizeObserver((entries) => entries.forEach((e) => updateHint(e.target)));
  const watch = (canvas: Element) => {
    updateHint(canvas);
    ro?.observe(canvas);
  };
  const reveal = (el: Element) => {
    const tpl = el.querySelector(':scope > template');
    if (!(tpl instanceof HTMLTemplateElement)) return;
    el.replaceChildren(tpl.content.cloneNode(true));
    el.removeAttribute('data-lazy-diagram');
    watch(el);
  };
  const revealAll = () => document.querySelectorAll('[data-lazy-diagram]').forEach(reveal);
  let io: IntersectionObserver | undefined;
  document.addEventListener('astro:page-load', () => {
    io?.disconnect();
    ro?.disconnect(); // observed canvases from the previous page would otherwise be retained
    document.querySelectorAll('.diagram-figure__canvas:not([data-lazy-diagram])').forEach(watch);
    const items = document.querySelectorAll('[data-lazy-diagram]');
    if (!items.length) return;
    if (!('IntersectionObserver' in window)) return revealAll();
    io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            reveal(e.target);
            io?.unobserve(e.target);
          }
        }
      },
      { rootMargin: '800px 0px' },
    );
    items.forEach((el) => io?.observe(el));
  });
  window.addEventListener('beforeprint', revealAll);

  const ZOOM_MIN = 0.25;
  const ZOOM_MAX = 3;
  const ZOOM_STEP = 1.25;
  let dialog: HTMLDialogElement | null = null;


  const ensureDialog = (): HTMLDialogElement => {
    if (dialog?.isConnected) return dialog;
    const d = document.createElement('dialog');
    d.className = 'diagram-dialog';
    d.setAttribute('aria-labelledby', 'diagram-dialog-title');
    d.innerHTML = `
      <div class="diagram-dialog__bar">
        <h2 id="diagram-dialog-title" class="diagram-dialog__title"></h2>
        <div class="diagram-dialog__tools" role="group" aria-label="Zoom">
          <button type="button" class="btn" data-zoom="out" aria-label="Zoom out">Zoom out</button>
          <button type="button" class="btn" data-zoom="reset" aria-label="Reset zoom">Reset</button>
          <button type="button" class="btn" data-zoom="in" aria-label="Zoom in">Zoom in</button>
          <output class="diagram-dialog__level" aria-live="polite"></output>
          <button type="button" class="btn" data-zoom="close">Close</button>
        </div>
      </div>
      <div class="diagram-dialog__body" role="region" tabindex="0" aria-label="Diagram, scroll to pan"></div>`;
    document.body.append(d);
    d.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === d) return d.close();
      const act = t.closest<HTMLElement>('[data-zoom]')?.dataset.zoom;
      if (act) zoom(d, act);
    });
    d.addEventListener('close', () => {
      d.querySelector('.diagram-dialog__body')?.replaceChildren();
    });
    dialog = d;
    return d;
  };

  const applyZoom = (d: HTMLDialogElement, scale: number) => {
    d.dataset.scale = String(scale);
    d.querySelectorAll<SVGSVGElement>('.diagram-dialog__body svg').forEach((svg) => {
      const w = Number(svg.dataset.naturalWidth);
      const vb = svg.viewBox.baseVal;
      if (!w || !vb.width) return;
      svg.setAttribute('width', String(Math.round(w * scale)));
      svg.setAttribute('height', String(Math.round(((vb.height / vb.width) * w) * scale)));
    });
    const out = d.querySelector('.diagram-dialog__level');
    if (out) out.textContent = `${Math.round(scale * 100)}%`;
  };

  const zoom = (d: HTMLDialogElement, act: string) => {
    if (act === 'close') return d.close();
    const cur = Number(d.dataset.scale || '1');
    const next = act === 'in' ? cur * ZOOM_STEP : act === 'out' ? cur / ZOOM_STEP : 1;
    applyZoom(d, Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, next)));
  };

  document.addEventListener('click', (e) => {
    const btn = (e.target as Element | null)?.closest<HTMLElement>('[data-diagram-fullscreen]');
    if (!btn) return;
    const figure = btn.closest('.diagram-figure');
    const canvas = figure?.querySelector('.diagram-figure__canvas');
    if (!figure || !canvas) return;
    reveal(canvas);
    const d = ensureDialog();
    const title = figure.querySelector('.diagram-figure__title')?.textContent ?? 'Diagram';
    const titleEl = d.querySelector('.diagram-dialog__title');
    if (titleEl) titleEl.textContent = title;
    const body = d.querySelector('.diagram-dialog__body');
    // Clone through markup and run the same id rewrite the build uses, so the
    // copy keeps its scoped theme CSS, markers and clip paths while its ids stay unique.
    if (body) body.innerHTML = [...canvas.querySelectorAll('.diagram')].map((n) => suffixIds(n.outerHTML, '-fs')).join('');
    applyZoom(d, 1);
    d.showModal();
    (d.querySelector('.diagram-dialog__body') as HTMLElement | null)?.focus();
  });
  document.addEventListener('astro:before-swap', () => {
    dialog?.close();
    dialog?.remove();
    dialog = null;
  });
</script>
