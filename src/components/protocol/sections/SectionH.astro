---
import Section from '../Section.astro';
import ThreatTable from '../ThreatTable.astro';
import ResolvedDiagramView from '../ResolvedDiagramView.astro';
import type { ProtocolPageContext } from '../lib/load';

export interface Props {
  ctx: ProtocolPageContext;
}
const { ctx } = Astro.props;
const data = ctx.loaded.sidecars.security;
const trust = ctx.trustDiagram;
---
<Section id="h-security" missing={data ? null : `${ctx.contentPath}security.json`}>
  {data && <ThreatTable security={data} />}
  {trust && (
    <>
      <h3 id="h-security-boundaries">Trust boundaries</h3>
      {trust.inSectionC ? (
        <p>The trust-boundary diagram is shown in section C: <a href={`#diagram-${trust.id}`}>{trust.meta?.title ?? trust.flow?.title ?? trust.machine?.title ?? trust.id}</a>.</p>
      ) : (
        <ResolvedDiagramView d={trust} sources={ctx.sources} sourceIndex={Object.fromEntries(ctx.order.map((id, i) => [id, i + 1]))} />
      )}
    </>
  )}
</Section>
