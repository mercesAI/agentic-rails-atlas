---
import Section from '../Section.astro';
import Timeline from '../Timeline.astro';
import type { ProtocolPageContext } from '../lib/load';

export interface Props {
  ctx: ProtocolPageContext;
}
const { ctx } = Astro.props;
const data = ctx.loaded.sidecars.timeline;
---
<Section id="m-timeline" missing={data ? null : `${ctx.contentPath}timeline.json`}>
  {data && (
    <>
      <Timeline events={data.events} />
      <p class="section-foot"><a href="/timeline/">See every protocol on the multi-lane timeline</a></p>
    </>
  )}
</Section>
