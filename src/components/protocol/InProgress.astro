---
/** Placeholder for a section whose data file does not exist yet. */
export interface Props {
  file: string;
}
const { file } = Astro.props;
---
<p class="in-progress">
  <span class="in-progress__mark" aria-hidden="true"></span>
  This section is in progress. Its data file <code>{file}</code> is not written yet.
</p>
