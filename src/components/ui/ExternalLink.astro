---
/** External link with an inline glyph and screen-reader text. No icon library. */
export interface Props {
  href: string;
  class?: string;
  title?: string;
}
const { href, class: className, title } = Astro.props;
---
<a href={href} class:list={['ext', className]} rel="noopener noreferrer external" title={title}><slot /><svg class="ext__glyph" viewBox="0 0 12 12" width="0.7em" height="0.7em" aria-hidden="true" focusable="false"><path d="M4.5 2.5h5v5M9.5 2.5 3 9" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg><span class="sr-only"> (external link)</span></a>

<style>
  .ext__glyph { display: inline-block; margin-left: 0.2em; vertical-align: 0.05em; opacity: 0.75; }
</style>
