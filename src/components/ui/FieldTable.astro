---
/** Field table for spec-deep blocks; `fields` are passed inline from the MDX. */
export interface Field {
  name: string;
  type: string;
  required: boolean;
  description: string;
  specRef?: string;
}
export interface Props {
  fields?: Field[];
  caption?: string;
  specVersion?: string;
}

const fields = Astro.props.fields ?? [];
const caption = Astro.props.caption ?? 'Fields';
const specVersion = Astro.props.specVersion;
---
<div class="table-wrap field-table" role="region" aria-label={caption} tabindex="0">
  <table>
    <caption>
      {caption}
      {specVersion && <span class="field-table__version">Spec version {specVersion}</span>}
    </caption>
    <thead>
      <tr><th scope="col">Field</th><th scope="col">Type</th><th scope="col">Required</th><th scope="col">Description</th></tr>
    </thead>
    <tbody>
      {fields.length === 0 && <tr><td colspan="4">Field list in progress.</td></tr>}
      {fields.map((f) => (
        <tr>
          <th scope="row"><code>{f.name}</code></th>
          <td><code>{f.type}</code></td>
          <td>{f.required ? 'Yes' : 'No'}</td>
          <td>
            {f.description}
            {f.specRef && (
              <>
                {' '}
                <a class="field-table__ref" href={f.specRef} rel="noopener noreferrer external">Spec<span class="sr-only"> reference for {f.name}</span></a>
              </>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
