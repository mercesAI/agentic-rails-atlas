---
/** Claim confidence: verified, reported, unverified. Shape and text, not color alone. Styles in site.css (shared with the React twin ConfBadge.tsx). */
import type { Confidence } from '../../lib/schemas';
import { CONFIDENCE_LABELS } from '../../lib/labels';

export interface Props {
  confidence: Confidence;
  compact?: boolean;
}
const { confidence, compact = false } = Astro.props;
---
<span class="conf-badge" data-confidence={confidence}>
  <span class="conf-badge__mark" aria-hidden="true"></span>
  {compact ? <span class="sr-only">{CONFIDENCE_LABELS[confidence]}</span> : CONFIDENCE_LABELS[confidence]}
</span>
