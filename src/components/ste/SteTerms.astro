---
/**
 * Technical nouns and technical verbs used in the STE section.
 * Write the slot as a list: "- **term**: one-line STE definition".
 * The linter checks only the definition text.
 */
export interface Props {
  title?: string;
}
const { title = 'Technical nouns and technical verbs' } = Astro.props;
---
<section class="ste-terms" data-ste-block="terms">
  <h3 class="ste-terms__title">{title}</h3>
  <div class="ste-terms__body"><slot /></div>
</section>

<style>
  .ste-terms { margin-block: 1.5rem; }
  .ste-terms__title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    color: var(--fg);
    margin: 0 0 0.5rem;
  }
  .ste-terms__body :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .ste-terms__body :global(li) {
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--border);
    color: var(--fg-muted);
    line-height: 1.55;
  }
  .ste-terms__body :global(li strong),
  .ste-terms__body :global(li code) { color: var(--fg); }
</style>
