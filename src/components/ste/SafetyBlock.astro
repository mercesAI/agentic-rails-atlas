---
/**
 * Shared markup for STE safety instructions. The signal word is visible text
 * and is also the accessible name, so the level of risk never depends on color.
 */
export interface Props {
  signal: 'CAUTION' | 'NOTE' | 'WARNING';
}
const { signal } = Astro.props;
---
<aside class="ste-safety" data-ste-block={signal.toLowerCase()} data-signal={signal} role="note" aria-label={signal}>
  <p class="ste-safety__signal"><span class="ste-safety__glyph" aria-hidden="true">{signal === 'NOTE' ? 'i' : '!'}</span>{signal}</p>
  <div class="ste-safety__body"><slot /></div>
</aside>

<style>
  .ste-safety {
    margin-block: 1.25rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--border-strong);
    border-inline-start-width: 4px;
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--fg);
  }
  .ste-safety[data-signal='CAUTION'],
  .ste-safety[data-signal='WARNING'] {
    border-inline-start-color: var(--confidence-reported);
    border-style: solid;
  }
  .ste-safety[data-signal='NOTE'] {
    border-inline-start-color: var(--link);
    border-inline-start-style: dashed;
  }
  .ste-safety__signal {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.375rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
  }
  .ste-safety__glyph {
    display: inline-grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    font-size: 0.75rem;
  }
  .ste-safety[data-signal='CAUTION'] .ste-safety__glyph,
  .ste-safety[data-signal='WARNING'] .ste-safety__glyph { border-radius: 2px; }
  .ste-safety__body :global(p) { margin: 0; line-height: 1.6; }
</style>
