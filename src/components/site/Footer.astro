---
import { SITE_NAME, ORG_NAME, ORG_URL, BUILD_DATE } from '../../lib/constants';
const year = BUILD_DATE.slice(0, 4);
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__about">
      <p class="site-footer__name">{SITE_NAME}</p>
      <p>
        A research tool by <a href={ORG_URL} rel="noopener">{ORG_NAME}</a>, the controls platform for agentic transactions.
        Every factual claim links to a source record with a confidence level. Playgrounds are simulations with no real funds, keys or wallets.
        Notes, progress and quiz results stay in your browser and never leave it.
      </p>
    </div>
    <nav aria-label="Footer" class="site-footer__nav">
      <ul>
        <li><a href="/methodology/">Methodology</a></li>
        <li><a href="/library/">Library</a></li>
        <li><a href="/glossary/">Glossary</a></li>
        <li><a href="/whats-new/">What's new</a></li>
        <li><a href="/notes/">Your notes</a></li>
        <li><a href={ORG_URL} rel="noopener">{ORG_NAME}</a></li>
      </ul>
    </nav>
    <p class="site-footer__meta">
      Built <time datetime={BUILD_DATE}>{BUILD_DATE}</time>. Published by {ORG_NAME} for research and education. Not legal, financial or security advice.
      Specifications and products change; accuracy is not guaranteed, so check the linked sources and the <a href="/methodology/">methodology</a> before relying on a claim.
      No logos are used; protocol and product names belong to their stewards. Text and diagrams are original work, copyright {year} {ORG_NAME}.
      <button type="button" class="link-btn" data-open-palette="help">Keyboard shortcuts</button>
    </p>
  </div>
</footer>
