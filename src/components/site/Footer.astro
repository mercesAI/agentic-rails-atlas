---
import { SITE_NAME, BUILD_DATE } from '../../lib/constants';
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__about">
      <p class="site-footer__name">{SITE_NAME}</p>
      <p>
        A personal study atlas. Every factual claim links to a source record with a confidence level.
        Playgrounds are simulations with no real funds, keys or wallets. Nothing you store here leaves your browser.
      </p>
    </div>
    <nav aria-label="Footer" class="site-footer__nav">
      <ul>
        <li><a href="/methodology/">Methodology</a></li>
        <li><a href="/library/">Library</a></li>
        <li><a href="/glossary/">Glossary</a></li>
        <li><a href="/whats-new/">What's new</a></li>
        <li><a href="/notes/">Your notes</a></li>
      </ul>
    </nav>
    <p class="site-footer__meta">
      Built <time datetime={BUILD_DATE}>{BUILD_DATE}</time>. Not legal, financial or security advice. No logos; protocol names belong to their stewards.
      <button type="button" class="link-btn" data-open-palette="help">Keyboard shortcuts</button>
    </p>
  </div>
</footer>
