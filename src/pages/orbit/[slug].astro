---
/** /orbit/<slug>/: mini page for a starred orbit item (what it is, status, how it relates to the eight, sources). */
import { render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import Cite from '../../components/ui/Cite.astro';
import Callout from '../../components/ui/Callout.astro';
import Mode from '../../components/ui/Mode.astro';
import ExternalLink from '../../components/ui/ExternalLink.astro';
import SourceList from '../../components/protocol/SourceList.astro';
import { getOrbitEntries, getProtocols, getSourcesMap, scanCiteIds } from '../../lib/content';
import { dedupe, setPageSources } from '../../lib/citations';
import { ORBIT_CATEGORY_LABELS, RELATION_LABELS, type OrbitCategoryId } from '../../components/hub/lib/orbit';
import '../../components/hub/hub.css';

export async function getStaticPaths() {
  const entries = await getOrbitEntries();
  return entries.filter((e) => e.data.starred).map((e) => ({ params: { slug: e.data.slug }, props: { entry: e } }));
}

const { entry } = Astro.props;
const item = entry.data;
const page = Astro.url.pathname;
const sources = await getSourcesMap();
const protocols = await getProtocols();
const protocolBySlug = new Map(protocols.map((p) => [p.slug, p]));
setPageSources(dedupe([...scanCiteIds(entry.body), ...item.sources]), { page, sources });
const { Content } = await render(entry);
const primary = item.sources.map((id) => sources.get(id)).find((s) => s?.primary) ?? sources.get(item.sources[0] ?? '');
const category = ORBIT_CATEGORY_LABELS[item.category as OrbitCategoryId] ?? item.category;
---
<Page title={item.name} eyebrow={`Orbit: ${category}`} lede={item.oneLiner} lastVerified={item.lastVerified}>
  <dl class="orbit-facts">
    <dt>Steward</dt><dd>{item.steward}</dd>
    <dt>Status</dt><dd>{item.status}</dd>
    {item.latestVersion && <><dt>Latest version</dt><dd>{item.latestVersion.label} (<time datetime={item.latestVersion.date}>{item.latestVersion.date}</time>)</dd></>}
    {primary && <><dt>Primary source</dt><dd><ExternalLink href={primary.url}>{primary.title}</ExternalLink></dd></>}
  </dl>

  <Content components={{ Cite, Callout, Mode }} />

  <h2 id="relations">Relations at a glance</h2>
  {item.relations.length === 0 ? (
    <p>No documented relation to any of the eight protocols.</p>
  ) : (
    <div class="table-wrap" role="region" aria-labelledby="relations-caption" tabindex="0">
      <table>
        <caption id="relations-caption">How {item.name} relates to each protocol</caption>
        <thead><tr><th scope="col">Protocol</th><th scope="col">Relation</th><th scope="col">Note</th></tr></thead>
        <tbody>
          {item.relations.map((r) => (
            <tr>
              <th scope="row"><a href={`/p/${r.to}/`}>{protocolBySlug.get(r.to)?.name ?? r.to}</a></th>
              <td>{RELATION_LABELS[r.type] ?? r.type}</td>
              <td>{r.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
  <p><a href={`/orbit/#orbit-${item.slug}`}>Back to the orbit</a></p>
  <SourceList page={page} />
</Page>
