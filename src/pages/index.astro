---
/**
 * Interim home. The bubble universe (BubbleUniverse island) replaces the
 * protocol list in a later phase; the slots below keep their positions.
 */
import Base from '../layouts/Base.astro';
import Monogram from '../components/ui/Monogram.astro';
import StatusDot from '../components/ui/StatusDot.astro';
import FreshnessBadge from '../components/ui/FreshnessBadge.astro';
import Chip from '../components/ui/Chip.astro';
import ProgressRing from '../components/islands/ProgressRing';
import { getProtocols } from '../lib/content';
import { SECTION_IDS } from '../lib/schemas';
import { SITE_NAME, SITE_TAGLINE } from '../lib/constants';

const protocols = await getProtocols();
const changed = protocols
  .slice()
  .sort((a, b) => b.latestVersion.date.localeCompare(a.latestVersion.date))
  .slice(0, 4);
---
<Base title={SITE_NAME}>
  <div class="home">
    <header class="home__intro">
      <p class="home__eyebrow">{SITE_NAME}</p>
      <h1 class="home__title">Atlas</h1>
      <p class="home__lede">{SITE_TAGLINE} Eight protocols, each with sourced claims, diagrams, a plain-language version and simulations you can run in the browser.</p>
    </header>

    <section class="home__protocols" aria-labelledby="protocols-h">
      <h2 id="protocols-h">Protocols</h2>
      {protocols.length === 0 ? (
        <p class="home__empty">Protocol pages are in progress. They appear here as each one passes its quality gates.</p>
      ) : (
        <ol class="protocol-list">
          {protocols.map((p) => (
            <li data-family={p.family}>
              <a href={`/p/${p.slug}/`} class="protocol-list__link">
                <Monogram label={p.monogram} family={p.family} />
                <span class="protocol-list__text">
                  <span class="protocol-list__name">{p.name}</span>
                  <span class="protocol-list__tagline">{p.tagline}</span>
                </span>
              </a>
              <span class="protocol-list__meta">
                <StatusDot status={p.status} />
                {p.rails.map((r) => <Chip rail={r}>{r}</Chip>)}
              </span>
            </li>
          ))}
        </ol>
      )}
    </section>

    <aside class="home__side">
      <section class="home__panel" aria-labelledby="start-h">
        <h2 id="start-h">Start here</h2>
        <p>New to agent payments? Read the glossary first, then compare the eight protocols side by side.</p>
        <ul class="home__links">
          <li><a href="/glossary/">Glossary</a></li>
          <li><a href="/compare/">Compare</a></li>
          <li><a href="/stack/">How the layers stack</a></li>
          <li><a href="/methodology/">How claims are sourced</a></li>
        </ul>
      </section>

      <section class="home__panel" aria-labelledby="changed-h">
        <h2 id="changed-h">Changed recently</h2>
        {changed.length === 0 ? (
          <p class="home__empty">Nothing to report yet.</p>
        ) : (
          <ul class="home__changes">
            {changed.map((p) => (
              <li>
                <a href={`/p/${p.slug}/`}>{p.name}</a> {p.latestVersion.label}
                <FreshnessBadge date={p.lastVerified} />
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="home__panel" aria-labelledby="progress-h">
        <h2 id="progress-h">Your progress</h2>
        <ProgressRing client:visible slugs={protocols.map((p) => p.slug)} sectionsPer={SECTION_IDS.length} label="Sections read" />
        <p class="home__note">Stored only in this browser.</p>
      </section>
    </aside>
  </div>
</Base>

<style>
  .home {
    display: grid; gap: 3rem;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 22rem);
    grid-template-areas: 'intro intro' 'protocols side';
  }
  .home__intro { grid-area: intro; max-width: 46rem; }
  .home__protocols { grid-area: protocols; }
  .home__side { grid-area: side; display: grid; gap: 1.25rem; align-content: start; }
  @media (max-width: 900px) {
    .home { grid-template-columns: 1fr; grid-template-areas: 'intro' 'protocols' 'side'; }
  }
  .home__eyebrow { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-subtle); }
  .home__title { font-size: clamp(2.5rem, 7vw, 4.5rem); letter-spacing: -0.035em; margin-top: 0.3rem; }
  .home__lede { margin-top: 1rem; font-size: 1.15rem; color: var(--fg-muted); max-width: 40rem; }
  h2 { font-size: 1.05rem; margin-bottom: 0.9rem; }
  .home__empty, .home__note { color: var(--fg-muted); font-size: 0.9rem; }
  .home__note { margin-top: 0.75rem; }
  .home__panel {
    padding: 1.1rem 1.2rem; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg-elevated);
  }
  .home__panel p { font-size: 0.9rem; color: var(--fg-muted); }
  .home__links { margin-top: 0.75rem; display: grid; gap: 0.3rem; font-size: 0.9rem; }
  .home__changes { display: grid; gap: 0.6rem; font-size: 0.9rem; }
  .home__changes li { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
  .protocol-list { display: grid; border-top: 1px solid var(--border); }
  .protocol-list li {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 1.5rem;
    padding: 1rem 0; border-bottom: 1px solid var(--border);
  }
  .protocol-list__link { display: flex; align-items: center; gap: 1rem; color: var(--fg); text-decoration: none; }
  .protocol-list__link:hover .protocol-list__name { color: var(--family-ink); }
  .protocol-list__text { display: grid; }
  .protocol-list__name { font-family: var(--font-heading); font-weight: 600; font-size: 1.1rem; }
  .protocol-list__tagline { font-size: 0.9rem; color: var(--fg-muted); }
  .protocol-list__meta { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
</style>
