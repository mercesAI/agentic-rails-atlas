---
/**
 * Home (ATLAS_PROMPT.md 4.3): the bubble universe island, then below the fold
 * the accessible protocol card list (the screen-reader path), "Start here",
 * the "Changed in the last 60 days" strip and the progress ring.
 * Works with any subset of protocol pages.
 */
import Base from '../layouts/Base.astro';
import { webSiteLd, organizationLd } from '../lib/seo';
import Monogram from '../components/ui/Monogram.astro';
import StatusDot from '../components/ui/StatusDot.astro';
import Chip from '../components/ui/Chip.astro';
import ProgressRing from '../components/islands/ProgressRing';
import BubbleUniverse from '../components/universe/BubbleUniverse';
import {
  buildPersonaMap,
  daysBefore,
  protocolRelations,
  recentEvents,
  resolveOrbit,
  toUniverseProtocol,
  type DatedEvent,
  type OrbitSeed,
  type PersonaSidecar,
} from '../components/universe/lib/data';
import type { OrbitCategoryId } from '../components/universe/lib/types';
import { RAIL_LABELS } from '../components/universe/lib/encoding';
import {
  getOrbitEntries,
  getPersonas,
  getProtocols,
  getRelations,
  getSourcesMap,
  getSidecar,
  getTimelineGlobal,
} from '../lib/content';
import { FAMILY_LABELS, LAYER_LABELS, SECTION_IDS } from '../lib/schemas';
import { BUILD_DATE, SITE_NAME, SITE_TAGLINE } from '../lib/constants';
import { SITE_BRAND, SITE_DESCRIPTION, ORG_URL, ORG_NAME } from '../lib/constants';

const protocols = await getProtocols();
const present = new Set<string>(protocols.map((p) => p.slug));
const bySlug = new Map(protocols.map((p) => [p.slug, p]));

const relations = protocolRelations(await getRelations(), present);

const personaSidecars: PersonaSidecar[] = [];
const events: (DatedEvent & { detail?: string })[] = [];
for (const p of protocols) {
  const ps = await getSidecar('protocolPersonas', p.slug);
  if (ps) personaSidecars.push(ps);
  const tl = await getSidecar('timeline', p.slug);
  for (const e of tl?.events ?? []) events.push({ ...e, protocol: p.slug });
}
for (const e of await getTimelineGlobal()) events.push(e);

const personaMap = buildPersonaMap(protocols, personaSidecars);
const personas = (await getPersonas())
  .map((p) => ({ id: p.id, name: p.name }))
  .sort((a, b) => a.name.localeCompare(b.name));

const orbitEntries = await getOrbitEntries();
const sourcesById = await getSourcesMap();
const orbitSeeds: OrbitSeed[] = orbitEntries.flatMap((e) => {
  const resolved = e.data.sources.map((id) => sourcesById.get(id)).filter((s): s is NonNullable<typeof s> => Boolean(s));
  const link = (resolved.find((s) => s.primary) ?? resolved[0])?.url;
  if (!link) return [];
  return [{ slug: e.data.slug, name: e.data.name, category: e.data.category as OrbitCategoryId, oneLiner: e.data.oneLiner, primaryLink: link }];
});
// Only starred entries get an /orbit/<slug>/ page (src/pages/orbit/[slug].astro).
const orbitPages = new Set(orbitEntries.filter((e) => e.data.starred).map((e) => e.data.slug));
const orbit = resolveOrbit(orbitSeeds, orbitPages);

const WINDOW_DAYS = 60;
const since = daysBefore(BUILD_DATE, WINDOW_DAYS);
const CHANGED_MAX = 12;
const changedAll = recentEvents(events, BUILD_DATE, WINDOW_DAYS);
const changed = changedAll.slice(0, CHANGED_MAX);
---
<Base title={SITE_NAME} seoTitle={`${SITE_BRAND}: agent identity, checkout and payment protocols explained`} description={SITE_DESCRIPTION} jsonLd={[webSiteLd(), { '@context': 'https://schema.org', ...organizationLd() }]}>
  <div class="home">
    <header class="home__intro">
      <p class="home__eyebrow">Research atlas by {ORG_NAME}</p>
      <h1 class="home__title">Agentic Rails Atlas</h1>
      <p class="home__lede">{SITE_TAGLINE} A research tool by <a href={ORG_URL} rel="noopener">merces.ai</a> that explains eight agent identity, intent, checkout and payment protocols, each with sourced claims, diagrams, a plain-language version and simulations you can run in the browser.</p>
      <p class="home__actions">
        <a class="home__start" href="/learn/">Start here</a>
        <a href="#protocols-h">Skip to the protocol list</a>
      </p>
    </header>

    <section class="home__universe" aria-labelledby="universe-h">
      <h2 id="universe-h" class="home__section-title">Protocol universe</h2>
      {protocols.length === 0 ? (
        <p class="home__empty">Protocol pages are in progress. They appear here as each one passes its quality gates.</p>
      ) : (
        <BubbleUniverse
          client:visible
          protocols={protocols.map(toUniverseProtocol)}
          relations={relations}
          orbit={orbit}
          personas={personas}
          personaMap={personaMap}
        />
      )}
    </section>

    <div class="home__below">
      <section class="home__protocols" aria-labelledby="protocols-h">
        <h2 id="protocols-h" tabindex="-1">Protocols</h2>
        <p class="home__note">The same {protocols.length} protocols as the universe, in reading order.</p>
        {protocols.length === 0 ? (
          <p class="home__empty">Protocol pages are in progress.</p>
        ) : (
          <ol class="protocol-list">
            {protocols.map((p) => (
              <li data-family={p.family}>
                <a href={`/p/${p.slug}/`} class="protocol-list__link">
                  <Monogram label={p.monogram} family={p.family} />
                  <span class="protocol-list__text">
                    <span class="protocol-list__name">{p.name}</span>
                    <span class="protocol-list__tagline">{p.tagline}</span>
                  </span>
                </a>
                <p class="protocol-list__intro">{p.intro}</p>
                <dl class="protocol-list__facts">
                  <div><dt>Family</dt><dd>{FAMILY_LABELS[p.family]}</dd></div>
                  <div><dt>Layer</dt><dd>{LAYER_LABELS[p.layerPrimary]}</dd></div>
                  <div><dt>First announced</dt><dd><time datetime={p.firstAnnounced}>{p.firstAnnounced}</time></dd></div>
                  <div><dt>Latest version</dt><dd>{p.latestVersion.label}, <time datetime={p.latestVersion.date}>{p.latestVersion.date}</time></dd></div>
                </dl>
                <span class="protocol-list__meta">
                  <StatusDot status={p.status} />
                  {p.rails.map((r) => <Chip rail={r}>{RAIL_LABELS[r]}</Chip>)}
                </span>
              </li>
            ))}
          </ol>
        )}
      </section>

      <aside class="home__side" aria-label="Getting started and progress">
        <section class="home__panel" aria-labelledby="start-h">
          <h2 id="start-h">Start here</h2>
          <p>New to agent payments? The learning path walks through the layers in order, from identity to settlement.</p>
          <ul class="home__links">
            <li><a href="/learn/">Learning path</a></li>
            <li><a href="/glossary/">Glossary</a></li>
            <li><a href="/compare/">Compare</a></li>
            <li><a href="/stack/">How the layers stack</a></li>
            <li><a href="/methodology/">How claims are sourced</a></li>
          </ul>
        </section>

        <section class="home__panel" aria-labelledby="progress-h">
          <h2 id="progress-h">Your progress</h2>
          <ProgressRing client:visible slugs={protocols.map((p) => p.slug)} sectionsPer={SECTION_IDS.length} label="Sections read" />
          <p class="home__note">Stored only in this browser.</p>
        </section>
      </aside>
    </div>

    <section class="home__changed" aria-labelledby="changed-h">
      <h2 id="changed-h">Changed in the last 60 days</h2>
      <p class="home__note">
        Timeline events dated <time datetime={since}>{since}</time> to <time datetime={BUILD_DATE}>{BUILD_DATE}</time>, newest first.
        {changedAll.length > changed.length && <> The latest {changed.length} of {changedAll.length}; the full list is on <a href="/whats-new/">what's new</a> and the <a href="/timeline/">timeline</a>.</>}
      </p>
      {changed.length === 0 ? (
        <p class="home__empty">No dated events in this window.</p>
      ) : (
        <ol class="changes">
          {changed.map((e) => {
            const p = e.protocol ? bySlug.get(e.protocol as (typeof protocols)[number]['slug']) : undefined;
            return (
              <li class="changes__item" data-family={p?.family}>
                <time class="changes__date" datetime={e.date}>{e.date}</time>
                <span class="changes__lane">{p ? p.name : e.lane}</span>
                {p ? (
                  <a class="changes__title" href={`/p/${p.slug}/#m-timeline`}>{e.title}</a>
                ) : (
                  <span class="changes__title">{e.title}</span>
                )}
              </li>
            );
          })}
        </ol>
      )}
    </section>
  </div>
</Base>

<style>
  .home { display: grid; gap: 1.5rem; }
  .home__intro { max-width: 48rem; }
  .home__eyebrow { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-subtle); }
  .home__title { font-size: clamp(2.25rem, 5vw, 3.5rem); letter-spacing: -0.035em; margin-top: 0.2rem; }
  .home__lede { margin-top: 0.6rem; font-size: 1.125rem; color: var(--fg-muted); max-width: 44rem; }
  .home__actions { margin-top: 0.9rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; font-size: 0.9375rem; }
  .home__start {
    display: inline-flex; align-items: center; padding: 0.5rem 1rem; border-radius: var(--radius-md);
    background: var(--accent); color: var(--accent-fg); font-weight: 600; text-decoration: none;
  }
  .home__start:hover { color: var(--accent-fg); background: var(--link-hover); }
  .home__section-title { font-size: 1.05rem; margin-bottom: 0.75rem; }
  h2 { font-size: 1.05rem; margin-bottom: 0.9rem; }
  .home__empty, .home__note { color: var(--fg-muted); font-size: 0.9375rem; }
  .home__protocols .home__note { margin: -0.5rem 0 0.75rem; }

  .home__below {
    display: grid; gap: 3rem;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 22rem);
  }
  @media (max-width: 900px) { .home__below { grid-template-columns: 1fr; } }
  .home__side { display: grid; gap: 1.25rem; align-content: start; }
  .home__panel { padding: 1.1rem 1.2rem; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg-elevated); }
  .home__panel p { font-size: 0.9375rem; color: var(--fg-muted); }
  .home__panel .home__note { margin-top: 0.75rem; }
  .home__links { margin-top: 0.75rem; display: grid; gap: 0.3rem; font-size: 0.9375rem; }
  #protocols-h:focus { outline: none; }

  .protocol-list { display: grid; border-top: 1px solid var(--border); }
  .protocol-list li {
    display: grid; gap: 0.6rem; padding: 1.1rem 0 1.2rem; border-bottom: 1px solid var(--border);
  }
  .protocol-list__link { display: flex; align-items: center; gap: 1rem; color: var(--fg); text-decoration: none; }
  .protocol-list__link:hover .protocol-list__name { color: var(--family-ink); }
  .protocol-list__text { display: grid; }
  .protocol-list__name { font-family: var(--font-heading); font-weight: 600; font-size: 1.1rem; }
  .protocol-list__tagline { font-size: 0.9375rem; color: var(--fg-muted); }
  .protocol-list__intro { font-size: 0.9375rem; color: var(--fg-muted); max-width: 68ch; }
  .protocol-list__facts { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; font-size: 0.875rem; }
  .protocol-list__facts div { display: flex; gap: 0.4rem; }
  .protocol-list__facts dt { color: var(--fg-subtle); }
  .protocol-list__facts dd { margin: 0; color: var(--fg); }
  .protocol-list__meta { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }

  .changes {
    display: grid; gap: 0; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    border-top: 1px solid var(--border);
  }
  .changes__item {
    display: grid; gap: 0.2rem; align-content: start; padding: 0.85rem 1rem 0.95rem 0.9rem;
    border-bottom: 1px solid var(--border); border-left: 2px solid var(--border);
  }
  .changes__item[data-family] { border-left-color: var(--family-fill); }
  .changes__date { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--fg-subtle); }
  .changes__lane { font-size: 0.75rem; color: var(--fg-muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .changes__title { font-size: 0.9375rem; color: var(--fg); }
  a.changes__title { color: var(--link); }
</style>
