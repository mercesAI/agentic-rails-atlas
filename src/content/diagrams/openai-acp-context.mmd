flowchart LR
  subgraph BZ["Buyer"]
    BU["Buyer confirms in the agent UI"]
  end
  subgraph AZ["Agent platform trust zone"]
    AG["Agent (for example ChatGPT)"]
    WH["Webhook receiver /agentic_checkout/webhooks/order_events"]
    FD["Feed API /feeds"]
  end
  subgraph MZ["Merchant trust zone (merchant of record)"]
    CS["Checkout API /checkout_sessions"]
