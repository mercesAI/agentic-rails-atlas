flowchart TD
  A["Receive open and closed mandates"] --> B{"Chain verifies under Delegate SD-JWT?<br/>closed signed by key in cnf, sd_hash matches"}
  B -- "no" --> E1["Error receipt: invalid_credential (terminal)"]
  B -- "yes" --> C{"Closed mandate keeps every value<br/>the open mandate fixed?"}
  C -- "no" --> E2["Error receipt: invalid_mandate (terminal)"]
  C -- "yes" --> D["Take the next constraint"]
  D --> F{"Known constraint type?"}
  F -- "no" --> E3["Error receipt: unresolved_constraint"]
  F -- "yes" --> G{"Constraint satisfied?<br/>for example amount within amount_range,<br/>payee in allowed_payees, line items matched"}
  G -- "no or cannot tell" --> E3
  G -- "yes" --> H{"More constraints?"}
  H -- "yes" --> D
  H -- "no" --> OK["Receipt status Success"]
  E3 -. "may signal fallback" .-> FB["Ask the user for a closed mandate,<br/>or use a non-agentic flow"]
