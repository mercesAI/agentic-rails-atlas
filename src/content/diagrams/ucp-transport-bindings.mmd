flowchart LR
  OP["One operation: create checkout"]
  OP --> R["REST: POST /checkout-sessions"]
  OP --> M["MCP: tools/call create_checkout"]
  OP --> A["A2A: message with DataPart a2a.ucp.checkout"]
  OP --> E["Embedded: ec.* JSON-RPC in a host frame"]
  R --> RH["UCP-Agent header, Idempotency-Key, Request-Id"]
  M --> MH["meta ucp-agent profile in arguments"]
  A --> AH["UCP-Agent and X-A2A-Extensions headers"]
  E --> EH["ec.ready, ec.start, ec.complete, ec.payment.credential_request"]
  R -. "described by" .-> D1["OpenAPI 3.1"]
  M -. "described by" .-> D2["OpenRPC, streamable HTTP"]
  A -. "described by" .-> D3["Agent Card at endpoint"]
  E -. "described by" .-> D4["OpenRPC"]
