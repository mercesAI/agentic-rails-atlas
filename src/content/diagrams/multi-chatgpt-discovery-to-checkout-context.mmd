flowchart LR
  SH["Shopper"]
  subgraph OZ["OpenAI"]
    CG["ChatGPT: search and<br/>Wallet approval"]
    PY["ChatGPT payment sheet<br/>(Instant Checkout in the plugin guidelines,<br/>beta for select marketplaces)"]
    DB["The shopper's dot:<br/>cloud browser"]
    KD["Key directory at chatgpt.com/.well-known/<br/>http-message-signatures-directory"]
  end
  subgraph CN["Card network"]
    TK["Payment token service<br/>(American Express, Mastercard or Visa)"]
  end
  subgraph MZ["Merchant zone (merchant of record)"]
    FD["Catalog and business profile"]
    ED["CDN or firewall"]
    WS["Existing website checkout"]
    PL["Plugin: headless MCP server<br/>(widget only in path C)"]
    VT["Delegate Payment vault<br/>(PCI DSS Level 1 only)"]
  end
  subgraph PZ["Payment processing"]
    PS["Merchant PSP, risk provider<br/>and card rails"]
  end
  FD -- "product feed and profile (Business Hub)" --> CG
  SH -- "asks; approves each purchase" --> CG
  DB -- "A1 signed requests (Web Bot Auth) and Forwarded signals" --> ED
  ED -- "A2 key lookup" --> KD
  ED -- "A3 verified visit and form posts" --> WS
  TK -- "A4 payment token after approval" --> CG
  CG -- "A5 token for the payment form" --> DB
  WS -- "A6 authorize; risk check" --> PS
  CG == "B1 headless tool calls (MCP)" ==> PL
  PL == "B2 continue_url: checkout continues on the site" ==> WS
  PL -. "C1 widget calls requestCheckout" .-> PY
  PY -. "C2 Level 1 only: delegate_payment (ACP)" .-> VT
  PY -. "C3 complete_checkout with a payment-method token" .-> PL
  PL -. "C4 charge" .-> PS
