flowchart TB
  subgraph C1["Challenge: WWW-Authenticate: Payment (402)"]
    R1["Required: id, realm, method, intent, request"]
    O1["Optional: digest, expires, description, header, opaque"]
    B1["id = HMAC-SHA256 over realm|method|intent|request|expires|digest|header|opaque"]
  end
  subgraph C2["Credential: Authorization: Payment base64url"]
    E2["challenge: echo of every parameter received"]
    S2["source: payer DID (optional)"]
    P2["payload: method proof"]
    H2["Payment-Authorization instead, when header was set"]
  end
  subgraph C3["Receipt: Payment-Receipt base64url (2xx only)"]
    F3["status success, method, timestamp, reference"]
    X3["method extras: subscriptionId, challengeId, channelId"]
  end
  R1 --> B1
  O1 --> B1
  C1 -- "client pays, then retries" --> C2
  C2 -- "server verifies and settles" --> C3
