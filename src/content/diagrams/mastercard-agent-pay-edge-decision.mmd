flowchart TB
  Q1{"Signature-Input with a scheme tag?"}
  Q2{"Required fields present, with @authority and @path?"}
  Q3{"Timestamps valid, window at most 8 min?"}
  Q4{"Nonce new in the last 8 min?"}
  Q5{"Key found for keyid?"}
  Q6{"Signature verifies?"}
  BOT["Apply non-agent bot policy"]
  BLOCK["Block the request"]
  REPLAY["Block the request (replay detected)"]
  OK["Record the nonce with its expiry; treat as a trusted agent"]
  Q1 -- "no" --> BOT
  Q1 -- "yes" --> Q2
  Q2 -- "no" --> BLOCK
  Q2 -- "yes" --> Q3
  Q3 -- "no" --> BLOCK
  Q3 -- "yes" --> Q4
  Q4 -- "no" --> REPLAY
  Q4 -- "yes" --> Q5
  Q5 -- "no" --> BLOCK
  Q5 -- "yes" --> Q6
  Q6 -- "no" --> BLOCK
  Q6 -- "yes" --> OK
