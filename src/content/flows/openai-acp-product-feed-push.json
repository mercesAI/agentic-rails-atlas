{
  "id": "openai-acp-product-feed-push",
  "protocol": "openai-acp",
  "title": "ACP product feed push (Feed API, 2026-04-17)",
  "summary": "The agent hosts the Feed API and the merchant pushes products to it. OpenAI's commerce docs now take only full feed snapshots, while its Ads Delta Feeds API updates existing variants with the same PATCH upsert shape (2026-11-14).",
  "specVersion": "2026-04-17",
  "specVersionDate": "2026-04-17",
  "actors": [
    {
      "id": "merchant",
      "label": "Merchant API",
      "kind": "merchant"
    },
    {
      "id": "agent",
      "label": "Agent (AI surface)",
      "kind": "agent"
    }
  ],
  "steps": [
    {
      "n": 1,
      "from": "merchant",
      "to": "agent",
      "label": "POST /feeds",
      "detail": "Create a feed (target_country); the response carries the server-assigned id. 201 on success.",
      "payload": {
        "format": "json",
        "content": "// Illustrative example, spec version 2026-04-17.\n{\n  \"target_country\": \"US\"\n}",
        "illustrative": true
      },
      "crossesTrustBoundary": true,
      "specRef": {
        "url": "https://github.com/agentic-commerce-protocol/agentic-commerce-protocol/blob/7fdd78df677a94dce04c770644b0fbbb1401272b/spec/2026-04-17/openapi/openapi.feed.yaml",
        "section": "/feeds"
      }
    },
    {
      "n": 2,
      "from": "merchant",
      "to": "agent",
      "label": "PATCH /feeds/{id}/products",
      "detail": "Upsert products by Product.id. Each product needs id and variants; each variant needs id and title. Feed prices use uppercase currency codes, while checkout uses lowercase.",
      "payload": {
        "format": "json",
        "content": "// Illustrative example, spec version 2026-04-17.\n{\n  \"products\": [\n    {\n      \"id\": \"prod_1\",\n      \"title\": \"Denim jacket\",\n      \"variants\": [\n        {\n          \"id\": \"var_1_m\",\n          \"title\": \"Medium\",\n          \"price\": {\n            \"amount\": 3000,\n            \"currency\": \"USD\"\n          }\n        }\n      ]\n    }\n  ]\n}",
        "illustrative": true
      },
      "crossesTrustBoundary": true,
      "specRef": {
        "url": "https://github.com/agentic-commerce-protocol/agentic-commerce-protocol/blob/7fdd78df677a94dce04c770644b0fbbb1401272b/spec/2026-04-17/openapi/openapi.feed.yaml",
        "section": "/feeds/{id}/products"
      },
      "failures": [
        {
          "condition": "Invalid product",
          "outcome": "4xx; fix and resend"
        }
      ]
    },
    {
      "n": 3,
      "from": "agent",
      "to": "merchant",
      "label": "GET /feeds/{id}/products (optional)",
      "detail": "Read back what the agent holds.",
      "specRef": {
        "url": "https://github.com/agentic-commerce-protocol/agentic-commerce-protocol/blob/7fdd78df677a94dce04c770644b0fbbb1401272b/spec/2026-04-17/openapi/openapi.feed.yaml",
        "section": "/feeds/{id}/products"
      }
    },
    {
      "n": 4,
      "from": "merchant",
      "to": "agent",
      "label": "Full file replacement (alternative)",
      "detail": "Send metadata.json plus products.jsonl to replace the whole set. OpenAI's commerce docs now describe only full snapshots by manual upload, hosted URL or SFTP, in OpenAI's own flat format (2026-11-14).",
      "specRef": {
        "url": "https://github.com/agentic-commerce-protocol/agentic-commerce-protocol/blob/7fdd78df677a94dce04c770644b0fbbb1401272b/spec/2026-04-17/openapi/openapi.feed.yaml",
        "section": "File format"
      }
    }
  ],
  "sources": [
    "src-openai-acp-openapi-feed-20260417",
    "src-openai-acp-changelog-20260417",
    "src-openai-acp-schema-feed-20260417",
    "src-openai-commerce-product-feeds",
    "src-openai-acp-ads-delta-feeds",
    "src-openai-commerce-feed-spec"
  ]
}
