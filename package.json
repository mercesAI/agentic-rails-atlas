{
  "name": "agentic-rails-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal, interactive, offline-capable atlas of eight agent identity, checkout and payment protocols.",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && tsx scripts/build-sw.ts",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && tsc --noEmit -p tsconfig.json && eslint . && tsx scripts/verify/validate-content.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "diagrams": "tsx scripts/flow-to-mermaid.ts && tsx scripts/render-diagrams.ts",
    "data": "tsx scripts/data/fetch-all.ts",
    "verify:coverage": "tsx scripts/check-coverage.ts",
    "verify:links": "tsx scripts/verify/check-links.ts",
    "verify:citations": "tsx scripts/verify/verify-citations.ts",
    "verify:sources": "tsx scripts/verify/verify-sources.ts",
    "lint:ste": "tsx scripts/ste/lint-ste.ts",
    "lint:style": "tsx scripts/style/lint-style.ts",
    "gates": "pnpm lint:style && pnpm lint:ste && pnpm verify:sources && pnpm verify:coverage && pnpm check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/markdown-satteri": "0.4.3",
    "@astrojs/mdx": "8.0.3",
    "@astrojs/react": "7.0.1",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@xyflow/react": "12.12.0",
    "ajv": "8.20.0",
    "astro": "7.3.8",
    "astro-pagefind": "2.0.1",
    "compromise": "14.18.0",
    "d3": "7.9.0",
    "fuse.js": "7.5.0",
    "jose": "6.2.12",
    "mermaid": "12.1.0",
    "oxc-transform-react": "0.153.0",
    "pagefind": "1.5.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "viem": "2.57.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/d3": "7.4.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.13.0",
    "playwright": "1.64.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
